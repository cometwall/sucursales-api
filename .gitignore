# ---- Supabase CLI ----
# Local CLI state: linked project ref, cached versions, pooler URL, etc.
# This is machine-specific and regenerated by `supabase link` / `supabase start`.
.temp/
.branches/

# ---- Environment variables / secrets ----
# Never commit real secrets. Keep a tracked .env.example instead.
.env
.env.*
!.env.example

# ---- Deno ----
.deno_dir/

# ---- Editor / OS ----
.DS_Store
Thumbs.db
*.log
